# Where Blocky keeps everything on this machine: panel/, servers/, and backups/. Usually the folder
# this file is in. Must be an absolute path (Docker needs it to mount each server's folder).
BLOCKY_HOST_STORAGE=/opt/blocky-panel
# Panel release to run (an image tag from ghcr.io/teamdebris/blockypanel-app). Defaults to latest.
# BLOCKY_VERSION=0.1.0
MINECRAFT_IMAGE=itzg/minecraft-server:latest
# Required. First-run setup asks for it to prove you own the machine, and it works afterwards as a
# one-hour recovery sign-in ("Locked out?" on the login page). At least 16 characters; generate one
# with: openssl rand -base64 24
# Changing it ends any recovery sessions. (Compose refuses to start while it's empty.)
BLOCKY_ADMIN_PASSWORD=
# Recommended setup: an HTTPS reverse proxy (Caddy, nginx) in front of the panel. See the README.
# Or use the bundled Caddy: download compose.caddy.yaml next to this file, point a domain at this
# machine, open ports 80 and 443, and uncomment these two lines (they also turn on the two settings below).
# COMPOSE_FILE=compose.yaml:compose.caddy.yaml
# BLOCKY_DOMAIN=panel.example.com
# Set true when the panel is served over HTTPS. Behind a trusted proxy that sends
# X-Forwarded-Proto: https, cookies are marked Secure automatically as well.
BLOCKY_COOKIE_SECURE=false
# Set true only when a reverse proxy is the only way to reach port 3000. Login throttling then uses
# the address the proxy appends to X-Forwarded-For, and origin checks use X-Forwarded-Host.
BLOCKY_TRUST_PROXY=false
# Interface Compose publishes port 3000 on. 0.0.0.0 (the default) answers on every interface, so the
# panel is reachable at http://<this machine's IP>:3000 from the LAN. On a machine that faces the
# internet, or behind a reverse proxy (see above), use 127.0.0.1 so only the proxy can reach it.
BLOCKY_BIND_ADDRESS=0.0.0.0
BLOCKY_STARTUP_TIMEOUT_SECONDS=180
# Hostname players connect to, shown with a copy button (e.g. play.example.com). Defaults to the panel's hostname.
# BLOCKY_PUBLIC_HOST=
# Optional: Discord (or Slack-compatible) webhook for failed backups, crashes, and failed operations.
# BLOCKY_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Offsite backups (cloud storage, another disk, or SFTP/NAS) are set up in the panel: Offsite backups.
# A public demo with fake servers and no Docker access is its own file: compose.demo.yaml (see the README).
